{
  "name": "zero-margin",
  "productName": "Zero Margin",
  "version": "0.6.8",
  "description": "An original cyberpunk tabletop game: squad skirmish and story campaigns, against the computer or with friends.",
  "author": "Zero Margin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/preload.cjs",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --linux AppImage --win portable",
    "relay": "node relay/server.mjs"
  },
  "build": {
    "appId": "me.dravilias.zeromargin",
    "productName": "Zero Margin",
    "artifactName": "ZeroMargin-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  },
  "desktopName": "zero-margin"
}
